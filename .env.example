# IntelliJ uses localhost. Compose sets DB_HOST=mysql on its private network.
DB_HOST=localhost
DB_PORT=3308
DB_NAME=unispace
# Set true in .env.local to create the database when it is missing.
DB_AUTO_CREATE=false
DB_USERNAME=
DB_PASSWORD=
DB_SSL_MODE=REQUIRED
DB_MIGRATIONS_ENABLED=false

# Required only for the separate Compose MySQL instance.
MYSQL_ROOT_PASSWORD=
